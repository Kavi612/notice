# Server Port
PORT=5000

# Allowed CORS origins (comma-separated for multiple origins, e.g. https://your-app.vercel.app,http://localhost:5173)
CORS_ORIGIN=

# PostgreSQL Database Connection URL (e.g. postgresql://user:password@host:5432/dbname)
DATABASE_URL=

# AWS Cognito Configuration
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
