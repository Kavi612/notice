# Deployed Express backend URL (e.g. https://api.yourdomain.com or https://notice-backend.onrender.com)
# In local development, leave this empty to use the Vite development server proxy.
# In production (Vercel build environment), set this to the deployed backend URL (no trailing slash).
# NOTE: Vite bakes this value in at build time; whenever you change this variable, a rebuild/redeploy is required.
VITE_API_BASE_URL=
